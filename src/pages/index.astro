---
import Hello from '../components/LandingPage.jsx';
import '../styles/global.css'; // Import global styles


---
<html>
  <head>
     <title>Meet the Angel of Code</title>
  </head>
  <body>
    <div class="background-cover"></div>
    <Hello />
    
    <h1 class="landing-page-header">Learn the thoughts and ways of <span>The Angel of Code</span></h1>
    <p class="landing-page-subheader">Your journey to mastering coding starts here. Learn the art of grammatical and empathic software engineering so that you can always say yes to a product delivery. A repeatable system to take anyone <span>from Junior to Staff level.</span></p>
    <div class="landing-page-buttons">
      <a class="primary" href="/lessons/self" class="button start-button">Get Started, just jump in</a>
      <a class="secondary" href="/about" class="button about-button">About the Angel of Code</a>
    </div>
    <div class="landing-page-features">
      <h2><a href="/lessons/">Lessons</a></h2>
      <ul>
        <li>Interactive Lessons</li>
        <li>Code Challenges</li>
        <li>Community Support</li>
        <li>Progress Tracking</li>
      </ul>
    </div>
    

    
  </body>
</html>